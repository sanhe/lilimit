{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "lilimit",
  "version": "0.1.0",
  "identifier": "dev.lilimit.widget",
  "build": {
    "beforeDevCommand": "pnpm dev:frontend",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "lilimit",
        "width": 280,
        "height": 140,
        "decorations": false,
        "resizable": false,
        "alwaysOnTop": true,
        "transparent": false,
        "center": true
      },
      {
        "label": "settings",
        "title": "lilimit settings",
        "width": 320,
        "height": 350,
        "decorations": true,
        "resizable": false,
        "alwaysOnTop": true,
        "transparent": false,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.icns", "icons/icon.png"]
  }
}
